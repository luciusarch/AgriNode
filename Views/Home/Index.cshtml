@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container py-5">
    <!-- Hero Section / Karşılama Alanı -->
    <div class="row align-items-center justify-content-center py-5">
        <div class="col-lg-8 text-center">
            <div class="mb-4">
                <i class="bi bi-tree-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h1 class="display-4 fw-bold text-dark mb-3">AgriNode Akıllı Tarım Platformu</h1>
            <p class="lead text-muted mb-4">
                Tarım arazilerinizi, sensör verilerinizi ve mahsullerinizi tek bir merkezden akıllıca yönetin.
                Gerçek zamanlı takipler ve uyarılarla verimliliğinizi en üst düzeye çıkarın.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-agri-primary btn-lg px-4 shadow-sm" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i> Yönetim Paneline Git
                </a>
                <a class="btn btn-outline-success btn-lg px-4" asp-controller="Crop" asp-action="Index">
                    <i class="bi bi-flower1 me-2"></i> Mahsulleri İncele
                </a>
            </div>
        </div>
    </div>

    <!-- Özellik Kartları -->
    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="card h-100 card-hover p-4 text-center">
                <div class="card-body">
                    <div class="text-success mb-3 fs-1">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <h5 class="card-title fw-bold">Canlı Sensör Takibi</h5>
                    <p class="card-text text-muted">Toprak nemi, sıcaklık ve su tankı durumlarını anlık olarak izleyin
                        ve kalibre edin.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 card-hover p-4 text-center">
                    <div class="card-body">
                        <div class="text-success mb-3 fs-1">
                            <i class="bi bi-flower1"></i>
                        </div>
                        <h5 class="card-title fw-bold">Mahsul Yönetimi</h5>
                        <p class="card-text text-muted">Ekili mahsullerinizi kolayca listeleyin, yeni mahsul ekleyin ve
                            gelişimlerini takip edin.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 card-hover p-4 text-center">
                        <div class="card-body">
                            <div class="text-success mb-3 fs-1">
                                <i class="bi bi-bell-fill"></i>
                            </div>
                            <h5 class="card-title fw-bold">Akıllı Uyarılar</h5>
                            <p class="card-text text-muted">Kritik eşik aşımlarında sistemin ürettiği uyarıları anında
                                görüntüleyin ve önlem alın.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>