@model AgriNode.Models.CropModel

@{
    ViewData["Title"] = "Yeni Mahsul Ekle";
}

<div class="container mt-4">
    <h2>Yeni Mahsul Ekle</h2>
    <hr />

    <!-- Hocanın istediği HtmlHelper Formu -->
    @using (Html.BeginForm("AddCrop", "Crop", FormMethod.Post))
    {
        <div class="mb-3">
            @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Örn: Domates (Sera 1)" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Type, new { @class = "form-label fw-bold" })
            @Html.DropDownListFor(m => m.Type, new List<SelectListItem>
            {
                new SelectListItem { Text = "Sebze", Value = "Sebze" },
                new SelectListItem { Text = "Meyve", Value = "Meyve" },
                new SelectListItem { Text = "Tahıl", Value = "Tahıl" }
            }, "Mahsul Türü Seçiniz", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.PlantingDate, new { @class = "form-label fw-bold" })
            @Html.EditorFor(m => m.PlantingDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
        </div>

        <button type="submit" class="btn btn-success">Mahsulü Sisteme Kaydet</button>
    }
</div>