@{
    ViewData["Title"] = "Mahsul Listesi";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-flower1 text-success me-2"></i>Mahsul Listesi</h2>
            <p class="text-muted mb-0">Ekim yapılan tarlaların ve mahsullerin genel durumu.</p>
        </div>
        <a asp-action="AddCrop" class="btn btn-agri-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Yeni Mahsul Ekle
        </a>
    </div>

    <div class="card shadow-sm p-4">
        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Mahsul Adı</th>
                        <th>Ekim Tarihi</th>
                        <th>Bölge / Sera</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">1</td>
                        <td><i class="bi bi-flower2 text-success me-1"></i> Domates</td>
                        <td>12.04.2026</td>
                        <td>Sera A-1</td>
                        <td><span class="badge bg-success">Gelişiyor</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-eye"></i> Detay</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold">2</td>
                        <td><i class="bi bi-flower2 text-success me-1"></i> Biber</td>
                        <td>15.04.2026</td>
                        <td>Sera B-2</td>
                        <td><span class="badge bg-warning text-dark">Sulama Bekliyor</span></td>
                        <td>
                            <button class="btn btn-sm btn-outline-success"><i class="bi bi-eye"></i> Detay</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>