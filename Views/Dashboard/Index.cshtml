@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-speedometer2 text-success me-2"></i>Akıllı Tarım Paneli</h2>
            <p class="text-muted mb-0">Sera ve tarla durumlarını anlık olarak takip edin.</p>
        </div>
    </div>

    <!-- İstatistik Kartları (Mobilde Alt Alta, Büyük Ekranlarda Yan Yana) -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-hover p-3 h-100 border-start border-success border-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Aktif Sensörler</h6>
                            <h3 class="fw-bold text-dark mb-0">12 / 14</h3>
                        </div>
                        <div class="fs-1 text-success bg-light rounded-circle p-3 d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-cpu-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-hover p-3 h-100 border-start border-primary border-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Ortalama Sıcaklık</h6>
                            <h3 class="fw-bold text-dark mb-0">24.5 °C</h3>
                        </div>
                        <div class="fs-1 text-primary bg-light rounded-circle p-3 d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-thermometer-half"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-hover p-3 h-100 border-start border-info border-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Toprak Nemi</h6>
                            <h3 class="fw-bold text-dark mb-0">%68</h3>
                        </div>
                        <div class="fs-1 text-info bg-light rounded-circle p-3 d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-droplet-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card card-hover p-3 h-100 border-start border-warning border-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h6 class="text-muted fw-semibold mb-1">Su Tankı Seviyesi</h6>
                            <h3 class="fw-bold text-dark mb-0">%85</h3>
                        </div>
                        <div class="fs-1 text-warning bg-light rounded-circle p-3 d-flex align-items-center justify-content-center"
                             style="width: 60px; height: 60px;">
                            <i class="bi bi-water"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı İşlemler / Uyarılar Alanı -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-graph-up text-success me-2"></i>Sistem Genel Durumu</h5>
                <p class="text-muted">Tüm sensörler normal aralıkta çalışıyor. Sulama otomasyonu aktif durumda.</p>
                <div class="alert alert-success d-flex align-items-center mt-3" role="alert">
                    <i class="bi bi-check-circle-fill flex-shrink-0 me-2 fs-4"></i>
                    <div>Herhangi bir kritik uyarı bulunmuyor. Sistem kararlı bir şekilde çalışmaktadır.</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-4 h-100 shadow-sm">
                <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Hızlı Kısayollar
                </h5>
                <div class="d-grid gap-2">
                    <a asp-controller="Crop" asp-action="AddCrop" class="btn btn-agri-primary text-start">
                        <i class="bi bi-plus-circle me-2"></i> Yeni Mahsul Ekle
                    </a>
                    <a asp-controller="Sensor" asp-action="Index" class="btn btn-outline-success text-start">
                        <i class="bi bi-cpu me-2"></i> Sensör Kalibrasyonu
                    </a>
                    <a asp-controller="Dashboard" asp-action="Alerts" class="btn btn-outline-secondary text-start">
                        <i class="bi bi-bell me-2"></i> Uyarı Geçmişi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>