@model List<AgriNode.Models.SensorModel>

@{
    ViewData["Title"] = "Sensör Listesi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Saha Sensörleri</h2>
            <p class="text-muted mb-0">Kayıtlı tüm sensörlerin anlık ölçüm ve durum bilgileri</p>
        </div>
        <a href="/Sensor/Calibration" class="btn btn-success">
            + Yeni Sensör Ekle / Kalibre Et
        </a>
    </div>

    @if (TempData["SensorMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Bilgi:</strong> @TempData["SensorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    @await Html.PartialAsync("_SensorCardPartial", item)
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info shadow-sm">
            Henüz kayıtlı bir sensör bulunmamaktadır. Sağ üstteki butondan yeni sensör ekleyebilirsiniz.
        </div>
    }