@{
    ViewData["Title"] = "Sensör Kalibrasyonu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm p-4">
                <div class="text-center mb-4">
                    <div class="text-success fs-1 mb-2">
                        <i class="bi bi-sliders"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Sensör Kalibrasyon Paneli</h3>
                    <p class="text-muted">Seçilen sensörün eşik değerlerini ve kalibrasyon ayarlarını güncelleyin.</p>
                </div>

                <form asp-action="Calibration" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Sensör Seçimi</label>
                        <select class="form-select">
                            <option>SNS-001 - Sıcaklık Sensörü</option>
                            <option>SNS-002 - Toprak Nem Sensörü</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kalibrasyon Değeri / Çarpanı</label>
                        <input type="number" step="0.1" class="form-control" placeholder="Örn: 1.0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Açıklama / Not</label>
                        <textarea class="form-control" rows="3" placeholder="Kalibrasyon nedenini yazın..."></textarea>
                    </div>
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-agri-primary py-2">
                            <i class="bi bi-check-lg me-1"></i> Kalibrasyonu Uygula
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>