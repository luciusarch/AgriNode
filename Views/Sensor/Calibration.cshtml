@model AgriNode.Models.SensorModel

@{
    ViewData["Title"] = "Yeni Sensör Ekle / Kalibre Et";

    var sensorTypes = new List<SelectListItem>
    {
        new SelectListItem { Text = "Sıcaklık Sensörü", Value = "Sıcaklık" },
        new SelectListItem { Text = "Toprak Nem Sensörü", Value = "Nem" },
        new SelectListItem { Text = "pH Sensörü", Value = "pH" },
        new SelectListItem { Text = "Su Seviyesi Sensörü", Value = "Su Seviyesi" },
        new SelectListItem { Text = "Işık Şiddeti Sensörü", Value = "Işık" }
    };

    var unitList = new List<SelectListItem>
    {
        new SelectListItem { Text = "°C (Derece)", Value = "°C" },
        new SelectListItem { Text = "% (Yüzde)", Value = "%" },
        new SelectListItem { Text = "pH", Value = "pH" },
        new SelectListItem { Text = "Lux", Value = "Lux" },
        new SelectListItem { Text = "Litre (L)", Value = "L" }
    };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0 fw-bold">Yeni Sensör Ekle / Kalibre Et</h4>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm())
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Sensör Konumu (Location)</label>
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "Örn: Sera-1 Kuzey Bölgesi", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Sensör Tipi (SensorType)</label>
                            @Html.DropDownListFor(m => m.SensorType, sensorTypes, "-- Sensör Tipi Seçiniz --", new { @class = "form-select", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Son Ölçüm Değeri (LastValue)</label>
                            @Html.TextBoxFor(m => m.LastValue, new { @class = "form-control", type = "number", step = "any", placeholder = "Örn: 24.5", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ölçüm Birimi (Unit)</label>
                            @Html.DropDownListFor(m => m.Unit, unitList, "-- Birim Seçiniz --", new { @class = "form-select", required = "required" })
                        </div>

                        <div class="form-check mb-4">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label fw-semibold">Sensör Aktif Mi? (IsActive)</label>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Sensor/Index" class="btn btn-outline-secondary">İptal / Geri Dön</a>
                            <button type="submit" class="btn btn-success px-4">Sensörü Kaydet</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>